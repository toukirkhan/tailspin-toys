---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryNames = new Map<number, string>();
const publisherNames = new Map<number, string>();

for (const game of games) {
  if (game.category) categoryNames.set(game.category.id, game.category.name);
  if (game.publisher) publisherNames.set(game.publisher.id, game.publisher.name);
}

const categories = [...categoryNames].map(([id, name]) => ({ id, name })).sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...publisherNames].map(([id, name]) => ({ id, name })).sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    {games.length === 0 ? (
      <EmptyState text="No games available at the moment." />
    ) : (
      <>
        <section
          aria-labelledby="game-filter-heading"
          class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
          data-testid="game-filters"
        >
          <h2 id="game-filter-heading" class="mb-5 text-xl font-medium text-slate-100">Filter Games</h2>

          <div class="grid gap-6 md:grid-cols-2">
            <fieldset data-testid="category-filters">
              <legend class="mb-3 font-medium text-slate-200">Categories</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-slate-200 hover:bg-slate-700">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      data-testid="category-filter"
                      class="size-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    />
                    {category.name}
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label for="publisher-filter" class="mb-3 block font-medium text-slate-200">Publisher</label>
              <select
                id="publisher-filter"
                data-testid="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>
          </div>

          <button
            type="button"
            data-testid="clear-filters"
            class="mt-5 rounded-lg border border-slate-600 px-4 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Clear filters
          </button>
        </section>

        <h2 class="mb-4 text-2xl font-medium text-slate-100">Featured Games</h2>
        <p id="filter-results" class="mb-4 text-slate-300" role="status" aria-live="polite" data-testid="filter-results">
          Showing all {games.length} {games.length === 1 ? 'game' : 'games'}.
        </p>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
        <p class="mt-6 text-center text-slate-300" data-testid="filtered-empty-state" hidden>
          No games match the selected filters.
        </p>
      </>
    )}
  </div>
</Layout>

<script>
  const filterControls = document.querySelector<HTMLElement>('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-testid="game-card"]'));
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const resultsStatus = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  if (filterControls && publisherFilter && resultsStatus && emptyState) {
    const categoryFilters = Array.from(
      filterControls.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );

    const updateResults = (): void => {
      const selectedCategories = categoryFilters
        .filter((filter) => filter.checked)
        .map((filter) => filter.value);
      const selectedPublisher = publisherFilter.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const matchesCategories = selectedCategories.every(
          (categoryId) => card.dataset.categoryId === categoryId,
        );
        const matchesPublisher =
          selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const isVisible = matchesCategories && matchesPublisher;

        card.hidden = !isVisible;
        if (isVisible) visibleCount++;
      }

      const noun = visibleCount === 1 ? 'game' : 'games';
      resultsStatus.textContent = `Showing ${visibleCount} of ${gameCards.length} ${noun}.`;
      emptyState.hidden = visibleCount > 0;
    };

    filterControls.addEventListener('change', updateResults);
    filterControls.querySelector('[data-testid="clear-filters"]')?.addEventListener('click', () => {
      for (const filter of categoryFilters) filter.checked = false;
      publisherFilter.value = '';
      updateResults();
    });
  }
</script>
